# Ticket de la API de Mercado Público (se solicita con Clave Única en chilecompra.cl/api)
MERCADOPUBLICO_TICKET=

# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Base de datos: SQLite local por defecto. En el servidor (Docker) no se usa: compose.yaml arma la
# conexión a Postgres con POSTGRES_PASSWORD.
DATABASE_URL=sqlite:///licita.db
# Solo servidor: clave de Postgres (generar con: openssl rand -base64 24) y dominio del sitio
POSTGRES_PASSWORD=
DOMINIO=calza.cl

# Modelos de IA (según el modelo de costos: Haiku para clasificar y filtrar)
LICITA_MODELO_CLASIFICACION=claude-haiku-4-5

# WhatsApp Cloud API de Meta (ver docs/whatsapp.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PLANTILLA_RESUMEN=resumen_diario_licitaciones
WHATSAPP_IDIOMA=es

# Enlace que se envía a números no registrados
LICITA_URL_REGISTRO=https://calza.cl/registro

# Análisis de bases (PDF)
LICITA_MODELO_ANALISIS=claude-sonnet-5-5
LICITA_DIR_DOCUMENTOS=documentos
LICITA_LIMITE_ANALISIS_MES=15

# Sitio web y pagos
LICITA_URL_PUBLICA=https://calza.cl
# Número de WhatsApp de Calza para el botón "Abrir WhatsApp" (formato 569XXXXXXXX)
LICITA_WHATSAPP_PUBLICO=
# Mercado Pago (cuenta de Virtus SpA durante el piloto). Para pruebas usa las credenciales de prueba (TEST-...).
MERCADOPAGO_ACCESS_TOKEN=
# Clave secreta de webhooks (Tus integraciones > Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=
# Empresa que presta y factura el servicio (cambiar a Calza SpA cuando exista)
LICITA_PRESTADOR=Virtus SpA
