# Ticket de la API de Mercado Público (se solicita con Clave Única en chilecompra.cl/api)
MERCADOPUBLICO_TICKET=

# Clave de la API de Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Base de datos (SQLite local por defecto; en producción usar Postgres)
DATABASE_URL=sqlite:///licita.db

# Modelos de IA (según el modelo de costos: Haiku para clasificar y filtrar)
LICITA_MODELO_CLASIFICACION=claude-haiku-4-5
