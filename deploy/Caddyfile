# Caddy obtiene y renueva solo los certificados HTTPS (Let's Encrypt).
{$DOMINIO} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy app:8000
}

www.{$DOMINIO} {
	redir https://{$DOMINIO}{uri} permanent
}

# Dominios anteriores o alternativos: redirigen al sitio principal (separados por coma).
{$DOMINIOS_REDIRIGIDOS} {
	redir https://{$DOMINIO}{uri} permanent
}
